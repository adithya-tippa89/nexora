# =============================================================
# SkillSync Maharashtra - Root Environment Template
# =============================================================

# Backend Configuration
PORT=5000
NODE_ENV=development

# Groq Cloud AI Configuration (Meta LLaMA 3)
# Sign up & get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Selection (LLaMA 3 family)
# Recommended options:
# - llama-3.3-70b-versatile   (Meta LLaMA 3.3 70B - Most versatile and accurate)
# - llama-3.1-8b-instant      (Meta LLaMA 3.1 8B  - Ultra-fast responses)
# - llama3-70b-8192           (Meta LLaMA 3 70B   - High capability)
# - llama3-8b-8192            (Meta LLaMA 3 8B    - Fast baseline)
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend Configuration (for frontend/.env)
VITE_API_URL=http://localhost:5000/api
