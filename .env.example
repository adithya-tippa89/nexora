# =============================================================
# SkillSync Maharashtra - Root Environment Template
# =============================================================

# Server Ports
PORT=5000
FASTAPI_PORT=8000
NODE_ENV=development

# Module 1: PostgreSQL & SQLAlchemy Configuration
# Format: postgresql+psycopg://username:password@hostname:5432/database_name
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skillsync_db

# Module 1: JWT Authentication & Security
JWT_SECRET_KEY=change_this_to_a_secure_random_key_min_32_characters_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Groq Cloud AI Configuration (Meta LLaMA 3)
# Sign up & get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend Configuration (for frontend/.env)
VITE_API_URL=http://localhost:5000/api
VITE_AUTH_API_URL=http://localhost:8000
