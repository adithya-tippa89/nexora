# SkillSync Maharashtra - Backend Environment Configuration

# Server Ports
PORT=5000
FASTAPI_PORT=8000

# Environment Mode (development | production)
NODE_ENV=development

# -------------------------------------------------------------
# Module 1: PostgreSQL & SQLAlchemy Configuration
# -------------------------------------------------------------
# Format: postgresql+psycopg://username:password@hostname:5432/database_name
# Or with pg8000: postgresql+pg8000://username:password@hostname:5432/database_name
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/skillsync_db
JOB_COLLECTION_INTERVAL_HOURS=6
JOB_SOURCE=arbeitnow

# -------------------------------------------------------------
# Module 1: JWT Authentication & Security
# -------------------------------------------------------------
JWT_SECRET_KEY=change_this_to_a_secure_random_key_min_32_characters_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -------------------------------------------------------------
# Groq Cloud AI Configuration (Meta LLaMA 3)
# -------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq LLaMA 3 Model Options:
# - llama-3.3-70b-versatile   (Recommended: Highest quality, 128k context, latest flagship LLaMA 3.3)
# - llama-3.1-8b-instant      (Ultra-fast, lowest latency LLaMA 3.1)
# - llama3-70b-8192           (LLaMA 3 70B parameter model)
# - llama3-8b-8192            (LLaMA 3 8B parameter model)
GROQ_MODEL=llama-3.3-70b-versatile
