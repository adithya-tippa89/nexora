# SkillSync Maharashtra - Backend Environment Configuration

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# -------------------------------------------------------------
# Groq Cloud AI Configuration (Meta LLaMA 3)
# -------------------------------------------------------------
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq LLaMA 3 Model Options:
# - llama-3.3-70b-versatile   (Recommended: Highest quality, 128k context, latest flagship LLaMA 3.3)
# - llama-3.1-8b-instant      (Ultra-fast, lowest latency LLaMA 3.1)
# - llama3-70b-8192           (LLaMA 3 70B parameter model)
# - llama3-8b-8192            (LLaMA 3 8B parameter model)
GROQ_MODEL=llama-3.3-70b-versatile
